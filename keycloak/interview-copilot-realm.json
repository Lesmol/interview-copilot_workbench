{
  "realm": "interview-copilot",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Adds the sub claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "interview-copilot/user",
      "description": "User access to the Interview Co-Pilot API",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "interview-copilot/service",
      "description": "Service-to-service access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "interview-copilot/act-as-user",
      "description": "Service may act on behalf of a user via X-User-Id",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "interview-copilot-spa",
      "name": "Interview Co-Pilot SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:${FRONTEND_PORT}/*"
      ],
      "webOrigins": [
        "http://localhost:${FRONTEND_PORT}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:${FRONTEND_PORT}/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email",
        "roles",
        "interview-copilot/user"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "interview-copilot-bff",
      "name": "Interview Co-Pilot BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "${BFF_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "interview-copilot/service",
        "interview-copilot/act-as-user"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "journalist",
      "email": "journalist@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Journalist",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "journalist2",
      "email": "journalist2@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Second",
      "lastName": "Journalist",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER2_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "passwordPolicy": "length(10)",
  "loginWithEmailAllowed": true,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}]}"
          ]
        }
      }
    ]
  }
}

# Copy to .env (gitignored) and replace every CHANGE_ME. Never commit .env.
GITHUB_OWNER=Lesmol
FRONTEND_REF=main
EDGE_GATEWAY_REF=main
BFF_REF=main
INTERNAL_GATEWAY_REF=main
BACKEND_REF=main

FRONTEND_PORT=8080
KEYCLOAK_PORT=8081
MAILPIT_PORT=8025

# Required for the live loop (milestones 2+); audio goes from the browser straight to Deepgram.
DEEPGRAM_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# IdP (Keycloak, local only)
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
BFF_CLIENT_SECRET=CHANGE_ME
TEST_USER_PASSWORD=CHANGE_ME

# Data stores (local only)
POSTGRES_PASSWORD=CHANGE_ME
